{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Work Item 狀態機",
    "output": "docs/diagrams/work-item-lifecycle.html",
    "viewBox": [
      1080,
      640
    ],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-path",
        "label": "主路徑",
        "focus": [
          "notstarted",
          "running",
          "verifying",
          "done"
        ],
        "note": "預設 Goal：verify PASS 即 DONE，同一交易解鎖下游；最後一件 DONE 時 Goal 自動完成。"
      },
      {
        "id": "loops",
        "label": "退回與重驗",
        "focus": [
          "running",
          "verifying",
          "review"
        ],
        "note": "FAIL、INTERRUPTED 與 REJECTED 都回到 RUNNING；要求 Approval 的 Goal，REVIEW 在 Candidate stale 時可再次 verify。"
      },
      {
        "id": "gate-dimension",
        "label": "Gate 正交維度",
        "focus": [
          "gate",
          "review",
          "notstarted"
        ],
        "note": "Gate 阻擋 start、verify 與 approve，但不改變狀態，因此不佔用狀態欄。"
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "狀態"
    },
    {
      "id": "approval",
      "label": "要求 Approval 的 Goal"
    },
    {
      "id": "orthogonal",
      "label": "正交維度（不是狀態）"
    }
  ],
  "states": [
    {
      "id": "notstarted",
      "type": "start",
      "label": "NOT_STARTED",
      "sublabel": "顯示為 PENDING／READY",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "讀取時計算"
    },
    {
      "id": "running",
      "type": "active",
      "label": "RUNNING",
      "sublabel": "start 之後",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "start"
    },
    {
      "id": "verifying",
      "type": "active",
      "label": "VERIFYING",
      "sublabel": "verify 之後",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "verify"
    },
    {
      "id": "done",
      "type": "success",
      "label": "DONE",
      "sublabel": "終態，不判 stale",
      "lane": "main",
      "col": 4,
      "tag": "PASS 或 approve"
    },
    {
      "id": "review",
      "type": "decision",
      "label": "REVIEW",
      "sublabel": "等 review approve",
      "lane": "approval",
      "col": 1,
      "tag": "PASS"
    },
    {
      "id": "gate",
      "type": "external",
      "label": "未解除的 Gate",
      "sublabel": "阻擋 start、verify、approve",
      "lane": "orthogonal",
      "col": 1,
      "tag": "ADR-0007",
      "yOffset": 110
    }
  ],
  "transitions": [
    {
      "id": "notstarted-running",
      "from": "notstarted",
      "to": "running",
      "label": "start"
    },
    {
      "id": "running-verifying",
      "from": "running",
      "to": "verifying",
      "label": "verify"
    },
    {
      "id": "verifying-running",
      "from": "verifying",
      "to": "running",
      "label": "FAIL／INTERRUPTED",
      "variant": "security",
      "route": "top-channel"
    },
    {
      "id": "verifying-review",
      "from": "verifying",
      "to": "review",
      "label": "PASS（要求 Approval）"
    },
    {
      "id": "verifying-done",
      "from": "verifying",
      "to": "done",
      "label": "PASS（預設）",
      "variant": "emphasis"
    },
    {
      "id": "review-done",
      "from": "review",
      "to": "done",
      "label": "approve",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "review-running",
      "from": "review",
      "to": "running",
      "label": "reject",
      "variant": "security"
    },
    {
      "id": "gate-blocks-approve",
      "from": "gate",
      "to": "review",
      "label": "阻擋 approve",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "主路徑",
      "items": [
        "持久化只有五個狀態，PENDING／READY 讀取時才計算",
        "沒有完成指令：PASS 或 approve 的結果才是 DONE，最後一件 DONE 時 Goal 同交易完成"
      ]
    },
    {
      "dot": "amber",
      "title": "退回與重驗",
      "items": [
        "FAIL 與 INTERRUPTED 都退回 RUNNING",
        "INTERRUPTED 是沒有結果，不是失敗"
      ]
    },
    {
      "dot": "cyan",
      "title": "單一佔位",
      "items": [
        "同一 workspace 最多一件 RUNNING 或 VERIFYING",
        "REVIEW 不佔位，DONE 解鎖下游"
      ]
    },
    {
      "dot": "violet",
      "title": "Gate 是另一個維度",
      "items": [
        "Gate 阻擋推進，但不改變狀態",
        "因此不佔用狀態欄（ADR-0007）"
      ]
    }
  ]
}
