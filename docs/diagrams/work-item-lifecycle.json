{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Work Item 狀態機",
    "output": "docs/diagrams/work-item-lifecycle.html",
    "viewBox": [
      1080,
      640
    ],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-path",
        "label": "主路徑",
        "focus": [
          "pending",
          "ready",
          "running",
          "verifying",
          "review",
          "done"
        ],
        "note": "從建立到完成的六個狀態，DONE 只能由 review approve 在條件成立時達成。"
      },
      {
        "id": "loops",
        "label": "退回與重驗",
        "focus": [
          "running",
          "verifying",
          "review"
        ],
        "note": "FAIL、INTERRUPTED 與 REJECTED 都回到 RUNNING；REVIEW 可再次 verify。"
      },
      {
        "id": "gate-dimension",
        "label": "Gate 正交維度",
        "focus": [
          "gate",
          "ready",
          "review"
        ],
        "note": "Gate 阻擋推進但不改變狀態，因此不佔用狀態欄。"
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "狀態"
    },
    {
      "id": "terminal",
      "label": "終態"
    },
    {
      "id": "orthogonal",
      "label": "正交維度（不是狀態）"
    }
  ],
  "states": [
    {
      "id": "pending",
      "type": "start",
      "label": "PENDING",
      "sublabel": "依賴未完成",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "建立"
    },
    {
      "id": "ready",
      "type": "active",
      "label": "READY",
      "sublabel": "依賴皆 DONE",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "依賴皆 DONE"
    },
    {
      "id": "running",
      "type": "active",
      "label": "RUNNING",
      "sublabel": "start 之後",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "start"
    },
    {
      "id": "verifying",
      "type": "active",
      "label": "VERIFYING",
      "sublabel": "verify 之後",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "verify"
    },
    {
      "id": "review",
      "type": "decision",
      "label": "REVIEW",
      "sublabel": "PASS 之後",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "PASS"
    },
    {
      "id": "done",
      "type": "success",
      "label": "DONE",
      "sublabel": "approve 且四條件",
      "lane": "terminal",
      "col": 2,
      "tag": "approve"
    },
    {
      "id": "gate",
      "type": "external",
      "label": "未解除的 Gate",
      "sublabel": "OPEN 數大於零",
      "lane": "orthogonal",
      "col": 0,
      "tag": "ADR-0007"
    }
  ],
  "transitions": [
    {
      "id": "verifying-running",
      "from": "verifying",
      "to": "running",
      "label": "FAIL／INTERRUPTED",
      "variant": "security",
      "route": "top-channel"
    },
    {
      "id": "review-running",
      "from": "review",
      "to": "running",
      "label": "reject",
      "variant": "security",
      "route": "bottom-channel",
      "labelDx": -120
    },
    {
      "id": "review-done",
      "from": "review",
      "to": "done",
      "label": "四項條件成立",
      "variant": "emphasis",
      "labelDy": 24
    },
    {
      "id": "gate-blocks-start",
      "from": "gate",
      "to": "ready",
      "label": "阻擋 start",
      "variant": "security"
    },
    {
      "id": "gate-blocks-done",
      "from": "gate",
      "to": "review",
      "label": "阻擋完成",
      "variant": "security",
      "channelX": 633,
      "labelDx": -34,
      "labelDy": -10
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "主路徑",
      "items": [
        "六個狀態，沒有 WAITING_HUMAN 也沒有 BLOCKED",
        "沒有完成指令，DONE 是條件成立的結果（ADR-0008）"
      ]
    },
    {
      "dot": "amber",
      "title": "退回與重驗",
      "items": [
        "FAIL 與 INTERRUPTED 都退回 RUNNING",
        "INTERRUPTED 是沒有結果，不是失敗"
      ]
    },
    {
      "dot": "violet",
      "title": "Gate 是另一個維度",
      "items": [
        "Gate 阻擋推進，但不改變狀態",
        "因此不佔用狀態欄（ADR-0007）"
      ]
    }
  ]
}