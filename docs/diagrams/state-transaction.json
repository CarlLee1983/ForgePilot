      "route": "bottom-channel"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "鎖的範圍",
      "items": [
        "鎖涵蓋 read-modify-write 全程",
        "只有 rename 擋不住 lost update"
      ]
    },
    {
      "dot": "cyan",
      "title": "一致性邊界",
      "items": [
        "四者共用同一次替換（ADR-0001）",
        "拆成兩次，中間態就會被讀到"
      ]
    },
    {
      "dot": "rose",
      "title": "失敗時",
      "items": [
        "留下舊 snapshot 或完整的新 snapshot",
        "不得留下截斷的 JSON"
      ]
    }
  ]
