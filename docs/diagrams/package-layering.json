  "cards": [
    {
      "dot": "emerald",
      "title": "依賴只往下",
      "items": [
        "cli 串接流程，但不自行判斷 transition 是否合法",
        "work 與 storage 都不知道 cli 的存在；status、review 的讀取路徑 cli 直接用 storage 與 repository"
      ]
    },
    {
      "dot": "cyan",
      "title": "沒有 interface",
      "items": [
        "internal/work 與 internal/storage 裡沒有任何 interface 宣告",
        "時間、exit code、Git 事實都是純值參數"
      ]
    },
    {
      "dot": "violet",
      "title": "外部世界只有一個出口",
      "items": [
        "所有 Git 呼叫走 repository 裡一個未匯出的 helper",
        "子程序一律由 process 啟動，只終止 leader 會讓 make verify 的子程序繼續跑"
      ]
    }
