{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:goal-plan-artifacts:manifest:1",
  "title": "PraxisBound Goal Plan Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plan",
    "declaration",
    "nodes",
    "reviewedSources",
    "coverageIndex"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "plan": {
      "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/planIdentity"
    },
    "declaration": {
      "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/sourceDigest"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeRef", "storyRef", "readinessContract", "dependsOn"],
        "properties": {
          "nodeRef": {
            "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/nodeRef"
          },
          "storyRef": {
            "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/repoPath"
          },
          "readinessContract": {
            "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/sourceDigest"
          },
          "dependsOn": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/nodeRef"
            }
          }
        }
      }
    },
    "reviewedSources": {
      "type": "array",
      "maxItems": 4000,
      "items": {
        "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/sourceDigest"
      }
    },
    "coverageIndex": {
      "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/coverageIndex"
    }
  }
}
