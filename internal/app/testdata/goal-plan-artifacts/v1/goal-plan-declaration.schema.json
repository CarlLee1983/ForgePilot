{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:goal-plan-artifacts:declaration:1",
  "title": "PraxisBound Goal Plan Declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plan", "nodes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "plan": {
      "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/planIdentity"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeRef", "storyRef", "dependsOn"],
        "properties": {
          "nodeRef": {
            "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/nodeRef"
          },
          "storyRef": {
            "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/repoPath"
          },
          "dependsOn": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:praxisbound:goal-plan-artifacts:defs:1#/$defs/nodeRef"
            }
          }
        }
      }
    }
  }
}
